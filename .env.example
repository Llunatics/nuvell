# Environment Configuration for nuvelll — Indonesia Book Release Intelligence Platform

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuvelll?schema=public"

# Redis Connection (for BullMQ Background Jobs & Cache)
REDIS_URL="redis://localhost:6379"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication Secret for /admin Crawler Dashboard
ADMIN_SECRET="nuvelll_admin_secret_key_2026"

# Crawler Polite Identification (Respectful User-Agent)
CRAWLER_USER_AGENT="nuvelll-bot/1.0 (+https://nuvelll.id/crawler-policy; contact@nuvelll.id)"

# Crawler Default Request Delay (in milliseconds, min 1500ms for respectful scraping)
CRAWLER_DEFAULT_DELAY_MS=2000

# Node Environment
NODE_ENV="development"
